model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["_Measures","income_statement","balance_sheet","cash_flow","revenue_by_product","peer_comps","price_data","valuation_summary","valuation_methods","dcf_projection","ProjectFolder"]

ref table _Measures
ref table income_statement
ref table balance_sheet
ref table cash_flow
ref table revenue_by_product
ref table peer_comps
ref table price_data
ref table valuation_summary
ref table valuation_methods
ref table dcf_projection

ref cultureInfo en-US
