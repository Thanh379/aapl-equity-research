table revenue_by_product
	lineageTag: 256dc519-c4f9-4287-b7ec-3c34a9b62f77

	column fiscal_year
		dataType: string
		lineageTag: 2b7b89a5-25b2-490b-b359-f3e139635084
		summarizeBy: none
		sourceColumn: fiscal_year

	column product
		dataType: string
		lineageTag: da6904a3-e5ef-48b8-a987-f52aef8c7fd2
		summarizeBy: none
		sourceColumn: product

	column revenue
		dataType: double
		formatString: #,0.##
		lineageTag: b8e4a635-b96c-4081-95d3-24968f18ddf1
		summarizeBy: sum
		sourceColumn: revenue

	partition revenue_by_product = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "data\revenue_by_product.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    TextCols = {"fiscal_year", "product"},
				    DateCols = {},
				    NumberCols = List.Difference(Table.ColumnNames(Headers), TextCols & DateCols),
				    Typed = Table.TransformColumnTypes(Headers,
				        List.Transform(TextCols, each {_, type text}) &
				        List.Transform(DateCols, each {_, type date}) &
				        List.Transform(NumberCols, each {_, type number}), "en-US")
				in
				    Typed
