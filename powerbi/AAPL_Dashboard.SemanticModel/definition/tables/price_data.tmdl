table price_data
	lineageTag: 38964f0d-9945-41ed-965d-64b2999ab7d0

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 0e66bb87-743a-4816-872a-744ba95ffbd1
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column ticker
		dataType: string
		lineageTag: 6d1365ed-9bb3-4d37-aaec-ed4ea855670b
		summarizeBy: none
		sourceColumn: ticker

	column open
		dataType: double
		formatString: #,0.##
		lineageTag: 5fef4aeb-9c42-407d-987b-ce551cb23d0f
		summarizeBy: sum
		sourceColumn: open

	column high
		dataType: double
		formatString: #,0.##
		lineageTag: 725dc19e-6cca-43b0-ac87-5b4ba07e74b9
		summarizeBy: sum
		sourceColumn: high

	column low
		dataType: double
		formatString: #,0.##
		lineageTag: d91f617d-2b45-417a-83c0-4839463cfe0e
		summarizeBy: sum
		sourceColumn: low

	column close
		dataType: double
		formatString: #,0.##
		lineageTag: 981d9cbe-b6cf-4fe2-ba0a-397228aadf4d
		summarizeBy: sum
		sourceColumn: close

	column volume
		dataType: double
		formatString: #,0.##
		lineageTag: 0fe49111-4bfb-4c9e-b1c6-1b343d696bb3
		summarizeBy: sum
		sourceColumn: volume

	partition price_data = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ProjectFolder & "data\raw\price_data_long.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    TextCols = {"ticker"},
				    DateCols = {"date"},
				    NumberCols = List.Difference(Table.ColumnNames(Headers), TextCols & DateCols),
				    Typed = Table.TransformColumnTypes(Headers,
				        List.Transform(TextCols, each {_, type text}) &
				        List.Transform(DateCols, each {_, type date}) &
				        List.Transform(NumberCols, each {_, type number}), "en-US")
				in
				    Typed
